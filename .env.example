# FPL Data Configuration
# Copy this file to .env and fill in your values

# Your FPL manager ID (found in your profile URL: fantasy.premierleague.com/entry/{manager_id}/)
FPL_MANAGER_ID=

# Root directory for data files (raw JSON and SQLite database)
FPL_DATA_DIR=data/

# Comma-separated list of seasons to track (e.g., 2024,2023,2022)
# Note: season year refers to the start year of the season (e.g., 2024 = 2024-25 season)
FPL_SEASON_YEARS=2024

# Bootstrap cache TTL in hours (how long to cache bootstrap-static)
FPL_CACHE_TTL_HOURS=6
